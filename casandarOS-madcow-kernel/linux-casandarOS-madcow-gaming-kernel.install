# vim: set ft=sh:

PKG_NAME="linux-casandarOS-madcow-gaming-kernel"
KVER="6.18.33-casandarOS-madcow-gaming-kernel"

post_install() {
    echo ">>> Generating initramfs for ${PKG_NAME}..."
    mkinitcpio -k "${KVER}" -g "/boot/initramfs-${PKG_NAME}.img" -g "/boot/initramfs-${PKG_NAME}-fallback.img" -S autodetect
    
    echo ">>> Updating bootloader..."
    if [[ -d /boot/loader/entries ]]; then
        echo ">>> systemd-boot detected. Creating entry..."
        cat > "/boot/loader/entries/${PKG_NAME}.conf" << ENTRY
title   CasandarOS Madcow Gaming Kernel ${KVER}
linux   /vmlinuz-${PKG_NAME}
initrd  /initramfs-${PKG_NAME}.img
options root=LABEL=root rw quiet loglevel=3 nowatchdog nmi_watchdog=0
ENTRY
        echo ">>> Entry: /boot/loader/entries/${PKG_NAME}.conf"
    elif command -v grub-mkconfig &>/dev/null; then
        grub-mkconfig -o /boot/grub/grub.cfg
    fi
    
    echo ">>> Installing gaming sysctl preset..."
    echo "    Apply with: sudo sysctl -p /etc/sysctl.d/99-madcow-gaming.conf"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ">>> Removing bootloader entry..."
    rm -f "/boot/loader/entries/${PKG_NAME}.conf"
    rm -f "/boot/initramfs-${PKG_NAME}.img"
    rm -f "/boot/initramfs-${PKG_NAME}-fallback.img"
}
